# Copy to .env before running the frontend:  cp .env.example .env
#
# Create React App only exposes variables prefixed with REACT_APP_, and it inlines
# them at build time -- restart `npm start` (or rebuild) after changing anything here.
#
# Both values are joined directly onto a path, as in `${REACT_APP_NODE_API_URL}auth/me`,
# so each MUST end with a trailing slash. Without these set, every request is sent to
# a URL beginning with the literal string "undefined".

# Express API. Must match Backend/.env PORT (default 4002).
REACT_APP_NODE_API_URL=http://localhost:4002/api/

# Django ML service. Serves /api/recommend/... (see Website/ml/ml/urls.py).
REACT_APP_DJANGO_API_URL=http://localhost:8000/api/
